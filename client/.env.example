# ============================================================================
# MMU FleetRadar 3D — Frontend environment
# Copy to .env and fill in real values. NEVER commit .env.
# All VITE_* values are baked into the bundle at build time.
# ============================================================================

# --- Backend location -------------------------------------------------------
# Leave blank for local dev (the app targets <page-host>:4000).
# Set for split deployments where the API lives on a different origin.
# VITE_SERVER_URL=https://api.mmumullana.org
# VITE_SERVER_PORT=4000

# Set to true for a single-origin deployment where a reverse proxy serves both
# the SPA and the API on the same host (the app then targets window.location.host).
VITE_SAME_ORIGIN=false

# --- Map basemap (optional) -------------------------------------------------
# Default is OpenFreeMap (free, key-free). To use Ola Maps, set both:
# VITE_MAP_PROVIDER=ola
# VITE_OLA_MAPS_API_KEY=your_ola_maps_api_key
