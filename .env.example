# ============================================================================
# MMU FleetRadar 3D — docker compose environment
# Copy to `.env` (compose reads it automatically) and fill in real values.
# NEVER commit `.env`.
# ============================================================================

# --- Data layer -------------------------------------------------------------
POSTGRES_USER=mmu
POSTGRES_PASSWORD=mmu_secret
POSTGRES_DB=mmu_fleet

# --- Backend ----------------------------------------------------------------
# Required by compose. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Comma-separated browser origin allowlist. Blank = same-origin only in prod.
CORS_ORIGIN=
# Trusted reverse-proxy hops in front of the server (nginx/LB).
TRUST_PROXY=1
# Demo personas are disabled automatically in production.
ENABLE_DEMO_ACCOUNTS=false

# --- Frontend ---------------------------------------------------------------
# Host port the SPA/nginx is published on.
CLIENT_PORT=8080
