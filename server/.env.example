# ============================================================================
# MMU FleetRadar 3D — Backend environment
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Security ---------------------------------------------------------------
# Required in production. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# Comma-separated browser origin allowlist. Leave blank in dev to reflect any origin.
# In production this MUST be set (e.g. https://app.mmumullana.org).
CORS_ORIGIN=

# --- Persistence ------------------------------------------------------------
DATABASE_URL=postgres://mmu:mmu_secret@127.0.0.1:5432/mmu_fleet
# Optional. When unset the server runs in PostgreSQL-only mode.
REDIS_URL=redis://127.0.0.1:6379

# --- Domain tuning ----------------------------------------------------------
GEOFENCE_RADIUS_METERS=1000
SPEED_LIMIT_KMH=75
MAX_TELEMETRY_SPEED_KMH=160
TELEMETRY_MIN_LAT=29.8
TELEMETRY_MAX_LAT=30.9
TELEMETRY_MIN_LNG=76.2
TELEMETRY_MAX_LNG=77.7

# --- Demo personas ----------------------------------------------------------
# Disabled automatically in production. Set ENABLE_DEMO_ACCOUNTS=true only for a
# controlled staging demo.
ENABLE_DEMO_ACCOUNTS=false
DEMO_PASSWORD=MMU@Secure2026

# --- Global access login ----------------------------------------------------
# Single shared credential that authenticates as any role (student/driver/admin).
# Change these before deploying. Do NOT ship the real values in the client.
GLOBAL_LOGIN_ID=global@mmumullana.org
GLOBAL_LOGIN_PASSWORD=MMU@Global2026
